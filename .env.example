# SAKAYSAYA FINANCE SYSTEM ENVIRONMENT VARIABLES - EXAMPLE TEMPLATE
# ---------------------------------------------------------------
# Copy this file to .env and fill in your actual credentials.
# .env is ignored by Git - never commit it.

# Database connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finance
DB_USER=root
DB_PASS=

# SMTP Mailer settings (Gmail: use a 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME="SakaySaya Finance"

# Sign-in: email a 6-digit code after the password (needs SMTP above).
# Set to false for local development without email.
LOGIN_OTP=true
