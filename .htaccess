# Serve the app from public/. Everything else in this folder (src/, database/,
# vendor/, .env) is never reachable from the browser.
# If your web server's document root already points at public/, this file is unused.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
